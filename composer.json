{
    "name": "aaieduhr/heartphrame-module-task",
    "description": "Interactive, audited task lists for HeartPhrame HTML documents.",
    "type": "heartphrame-module",
    "license": "EUPL-1.2",
    "minimum-stability": "stable",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://gitlab.opencode.hr/srce/aai-eduhr/heartphrame/heartphrame-framework.git"
        },
        {
            "type": "vcs",
            "url": "https://gitlab.opencode.hr/srce/aai-eduhr/heartphrame/heartphrame-module-auth.git"
        },
        {
            "type": "vcs",
            "url": "https://gitlab.opencode.hr/srce/aai-eduhr/heartphrame/heartphrame-module-orm.git"
        },
        {
            "type": "vcs",
            "url": "https://gitlab.opencode.hr/srce/aai-eduhr/heartphrame/heartphrame-module-html-editor.git"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-dom": "*",
        "aaieduhr/heartphrame-framework": ">=0.0.22 <1.0",
        "aaieduhr/heartphrame-module-auth": "^1.1",
        "aaieduhr/heartphrame-module-orm": "^1.1.2",
        "aaieduhr/heartphrame-module-editor-html": "^0.1 || dev-main"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10 || ^11",
        "rector/rector": "^2.0",
        "squizlabs/php_codesniffer": "^3",
        "slevomat/coding-standard": "^8"
    },
    "suggest": {
        "aaieduhr/heartphrame-module-workspace": "Applies inherited Workspace view and edit permissions to task changes.",
        "aaieduhr/heartphrame-module-notification": "Can be used later for task assignment and due-date notifications."
    },
    "autoload": {
        "psr-4": {
            "AaiEduHr\\HeartPhrameModuleTask\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AaiEduHr\\HeartPhrameModuleTask\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Srce",
            "email": "aai@srce.hr"
        }
    ],
    "config": {
        "sort-packages": true,
        "cache-dir": "build/composer",
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        },
        "optimize-autoloader": true,
        "composer-runtime-api": "^2.1"
    },
    "scripts": {
        "pre-commit": [
            "vendor/bin/phpcbf",
            "vendor/bin/rector --clear-cache",
            "vendor/bin/phpcs -p",
            "vendor/bin/phpstan --memory-limit=1024M",
            "vendor/bin/phpstan analyze -c phpstan-dev.neon --memory-limit=1024M",
            "vendor/bin/phpunit"
        ],
        "on-commit": [
            "vendor/bin/phpcs -p",
            "vendor/bin/rector --dry-run --clear-cache",
            "vendor/bin/phpstan --memory-limit=1024M",
            "vendor/bin/phpstan analyze -c phpstan-dev.neon --memory-limit=1024M",
            "vendor/bin/phpunit"
        ]
    }
}
